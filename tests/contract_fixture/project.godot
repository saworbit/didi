; The fixed project the contract snapshots read. See tests/contract_snapshots.
; Every answer recorded there depends on these files, so a change here is a
; change to every snapshot: regenerate them in the same pull request.

config_version=5

[application]

config/name="Didi Contract Fixture"
run/main_scene="res://main.tscn"
config/features=PackedStringArray("4.5")

[autoload]

GameState="*res://content/game_state.gd"

[editor_plugins]

enabled=PackedStringArray("res://addons/didi/plugin.cfg")

[input]

jump={
"deadzone": 0.2,
"events": [Object(InputEventKey,"resource_local_to_scene":false,"resource_name":"","device":-1,"window_id":0,"alt_pressed":false,"shift_pressed":false,"ctrl_pressed":false,"meta_pressed":false,"pressed":false,"keycode":0,"physical_keycode":32,"key_label":0,"unicode":32,"location":0,"echo":false,"script":null)
]
}

[rendering]

renderer/rendering_method="gl_compatibility"
