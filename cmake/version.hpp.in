#pragma once

// Generated from project(VERSION ...) in CMakeLists.txt. The copy in the build
// tree is an output: do not edit it, and do not spell the version out anywhere
// else. Everything in C++ that needs it reads this.

namespace didi {

inline const char* kProjectVersion = "@PROJECT_VERSION@";

// Which build this binary came out of, not which release it claims to be.
//
// The server and the GDExtension are separate files that a user copies around
// separately, so the two halves of one install can come from different builds
// while both say 1.6.0. The version alone cannot tell them apart. This can:
// it carries the commit and the moment the build tree was configured, so two
// binaries match only when they were configured together.
// Declared here and defined in the generated build_id.cpp. The string changes
// on every configure, and this header sits behind mcp_protocol.hpp, which 28
// files include, so holding the value here meant a reconfigure with no source
// change recompiled 57 of 149 targets (#633). One translation unit now
// recompiles instead, and this header changes only when the version does.
extern const char* const kBuildId;

}  // namespace didi
